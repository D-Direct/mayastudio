# MayaStudio AI - Backend Environment Variables

# Application
APP_NAME=MayaStudio AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# API
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379

# Celery
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxx...

# Google OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Google AI
GEMINI_API_KEY=AIzaSyXxx

# Google Service Account (paste entire JSON content as one line)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Security
SECRET_KEY=your-secret-key-change-in-production

# File Processing
TEMP_DIR=/app/temp
MAX_UPLOAD_SIZE=104857600

# CORS (add your Vercel URL here)
# CORS_ORIGINS=["http://localhost:3000","https://mayastudio.vercel.app"]
